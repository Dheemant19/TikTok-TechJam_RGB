# Required local KuaiRand-Pure directory. Use an absolute path on every platform.
KUAIRAND_DATA_DIR=/absolute/path/to/KuaiRand-Pure/data

# Required only for autonomous LLM-guided research runs.
AZURE_FOUNDRY_ENDPOINT=https://your-project.services.ai.azure.com
AZURE_FOUNDRY_API_KEY=replace-with-your-key
AZURE_FOUNDRY_API_VERSION=2025-04-01-preview
AZURE_RESEARCH_MODEL_DEPLOYMENT=your-research-model-deployment
AZURE_CODE_MODEL_DEPLOYMENT=your-code-model-deployment
AZURE_CHAT_MODEL_DEPLOYMENT=your-chat-model-deployment

# Optional: raises GitHub API limits for the research knowledge provider.
GITHUB_TOKEN=
